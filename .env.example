# Supabase project settings, Project Settings then API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Web push, for rest alerts that reach a locked phone. Generate a pair with
# `npx web-push generate-vapid-keys`. The public key goes in twice: the browser
# needs it to subscribe, the server needs it to sign. Leave all four unset and
# the feature turns itself off.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
