# Supabase project settings, Project Settings then API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Web push, for rest alerts that reach a locked phone. Generate a pair with
# `npx web-push generate-vapid-keys`. The public key goes in twice: the browser
# needs it to subscribe, the server needs it to sign. Leave all four unset and
# the feature turns itself off.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# The admin view, on the profile page. A comma separated allowlist of emails
# that cannot be edited from inside the app, and the key that can read the auth
# table. That key bypasses row level security completely and must never be
# given a NEXT_PUBLIC_ prefix, which would compile it into the browser bundle.
#
# Newer Supabase projects call it a Secret key (sb_secret_...) under API Keys
# rather than service_role; it is the same thing and the variable name here does
# not change. Leave both unset and the admin view does not exist for anybody.
ADMIN_EMAILS=you@example.com
SUPABASE_SERVICE_ROLE_KEY=

# Ask Lifty answers with a model when this is set. Absent is off, not broken:
# the sheet falls back to searching the hand written answers.
ANTHROPIC_API_KEY=
